{
  "title": "Game coach response",
  "type": "object",
  "required": [
    "game_id",
    "coach_id",
    "decision",
    "player_text",
    "evidence_ids",
    "missing_conditions",
    "reason_code",
    "versions",
    "trace_id"
  ],
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "coach_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "answer",
        "conditional",
        "clarify",
        "abstain",
        "silent"
      ]
    },
    "player_text": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_code": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "required": [
        "skill",
        "kb_snapshot",
        "adapter",
        "coach_config",
        "model"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "kb_snapshot": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "coach_config": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "trace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
