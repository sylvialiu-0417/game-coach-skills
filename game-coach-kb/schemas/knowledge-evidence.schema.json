{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game coach knowledge evidence",
  "type": "object",
  "required": ["evidence_id", "game_id", "content", "source_ref", "source_tier", "ruleset_scope", "mode_scope", "status", "valid_from", "valid_to", "applicability", "retrieved_at"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "game_id": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "source_tier": {"enum": ["official", "reviewed", "community"]},
    "ruleset_scope": {"type": "string", "minLength": 1},
    "mode_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["draft", "reviewed", "published", "retired"]},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "retrieved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
